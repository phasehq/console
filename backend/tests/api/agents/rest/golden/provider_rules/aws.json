{
  "credential_environment": [
    "AWS_ACCESS_KEY_ID",
    "AWS_CONFIG_FILE",
    "AWS_CONTAINER_AUTHORIZATION_TOKEN",
    "AWS_CONTAINER_AUTHORIZATION_TOKEN_FILE",
    "AWS_CONTAINER_CREDENTIALS_FULL_URI",
    "AWS_CONTAINER_CREDENTIALS_RELATIVE_URI",
    "AWS_CREDENTIAL_EXPIRATION",
    "AWS_DEFAULT_PROFILE",
    "AWS_PROFILE",
    "AWS_ROLE_ARN",
    "AWS_ROLE_SESSION_NAME",
    "AWS_SECRET_ACCESS_KEY",
    "AWS_SECURITY_TOKEN",
    "AWS_SESSION_TOKEN",
    "AWS_SHARED_CREDENTIALS_FILE",
    "AWS_WEB_IDENTITY_TOKEN_FILE"
  ],
  "secret_guard": {
    "operations": {
      "cognito-identity": [
        "GetCredentialsForIdentity",
        "GetOpenIdToken",
        "GetOpenIdTokenForDeveloperIdentity"
      ],
      "ec2": [
        "CreateKeyPair"
      ],
      "ecr": [
        "GetAuthorizationToken"
      ],
      "ecr-public": [
        "GetAuthorizationToken"
      ],
      "elasticmapreduce": [
        "GetClusterSessionCredentials"
      ],
      "gamelift": [
        "GetComputeAuthToken"
      ],
      "iam": [
        "CreateAccessKey",
        "CreateLoginProfile",
        "UpdateLoginProfile",
        "CreateServiceSpecificCredential",
        "ResetServiceSpecificCredential",
        "UploadSSHPublicKey",
        "UploadSigningCertificate"
      ],
      "lightsail": [
        "GetInstanceAccessDetails",
        "CreateKeyPair",
        "DownloadDefaultKeyPair",
        "CreateBucketAccessKey"
      ],
      "redshift": [
        "GetClusterCredentials",
        "GetClusterCredentialsWithIAM"
      ],
      "redshift-serverless": [
        "GetCredentials"
      ],
      "sts": [
        "AssumeRole",
        "AssumeRoleWithSAML",
        "AssumeRoleWithWebIdentity",
        "AssumeRoot",
        "GetFederationToken",
        "GetSessionToken",
        "GetWebIdentityToken"
      ]
    },
    "paths": [
      {
        "method": "POST",
        "pattern": "/v1/authorization-token",
        "operation": "codeartifact:GetAuthorizationToken",
        "services": [
          "codeartifact"
        ]
      },
      {
        "method": "GET",
        "pattern": "/*",
        "query": "session",
        "operation": "s3express:CreateSession",
        "services": [
          "s3express"
        ]
      },
      {
        "method": "POST",
        "pattern": "/keys-and-certificate",
        "operation": "iot:CreateKeysAndCertificate",
        "services": [
          "iot",
          "execute-api"
        ],
        "host_label": "iot"
      },
      {
        "method": "POST",
        "pattern": "/provisioning-templates/*/provisioning-claim",
        "operation": "iot:CreateProvisioningClaim",
        "services": [
          "iot",
          "execute-api"
        ],
        "host_label": "iot"
      },
      {
        "method": "POST",
        "pattern": "/certificates",
        "operation": "iot:CreateCertificateFromCsr",
        "services": [
          "iot",
          "execute-api"
        ],
        "host_label": "iot"
      },
      {
        "method": "POST",
        "pattern": "/apikeys",
        "operation": "apigateway:CreateApiKey",
        "services": [
          "apigateway"
        ]
      },
      {
        "method": "GET",
        "pattern": "/apikeys",
        "query": "includeValues",
        "operation": "apigateway:GetApiKeys with the key values",
        "services": [
          "apigateway"
        ]
      },
      {
        "method": "GET",
        "pattern": "/apikeys/*",
        "query": "includeValue",
        "operation": "apigateway:GetApiKey with the key value",
        "services": [
          "apigateway"
        ]
      },
      {
        "method": "GET",
        "pattern": "/v1/apis/*/apikeys",
        "operation": "appsync:ListApiKeys",
        "services": [
          "appsync"
        ]
      },
      {
        "method": "POST",
        "pattern": "/v1/apis/*/apikeys",
        "operation": "appsync:CreateApiKey",
        "services": [
          "appsync"
        ]
      },
      {
        "method": "POST",
        "pattern": "/v1/apis/*/apikeys/*",
        "operation": "appsync:UpdateApiKey",
        "services": [
          "appsync"
        ]
      },
      {
        "method": "POST",
        "pattern": "/clitoken/*",
        "operation": "airflow:CreateCliToken",
        "services": [
          "airflow"
        ]
      },
      {
        "method": "POST",
        "pattern": "/webtoken/*",
        "operation": "airflow:CreateWebLoginToken",
        "services": [
          "airflow"
        ]
      },
      {
        "method": "POST",
        "pattern": "/workspaces/*/apikeys",
        "operation": "grafana:CreateWorkspaceApiKey",
        "services": [
          "grafana"
        ]
      },
      {
        "method": "POST",
        "pattern": "/workspaces/*/serviceaccounts/*/tokens",
        "operation": "grafana:CreateWorkspaceServiceAccountToken",
        "services": [
          "grafana"
        ]
      },
      {
        "method": "POST",
        "pattern": "/virtualclusters/*/endpoints/*/credentials",
        "operation": "emr-containers:GetManagedEndpointSessionCredentials",
        "services": [
          "emr-containers"
        ]
      }
    ]
  }
}
