{
  "schemaVersion": 1,
  "id": "render",
  "name": "Render",
  "description": "The Render API with an API key.",
  "docsUrl": "https://render.com/docs/api",
  "category": "cloud",
  "hostsEditable": false,
  "labels": {
    "token": "API key"
  },
  "definition": {
    "specVersion": 1,
    "hosts": [
      {
        "match": "exact",
        "value": "api.render.com",
        "port": 443,
        "path": "/v1/*"
      }
    ],
    "fields": [
      {
        "name": "token",
        "kind": "secret",
        "source": {
          "type": "sealed"
        },
        "env": "RENDER_API_KEY",
        "decoyPrefix": "rnd_"
      }
    ],
    "injections": [
      {
        "type": "header",
        "name": "Authorization",
        "prefix": "Bearer ",
        "field": "token",
        "whenAbsent": "attach"
      }
    ],
    "preset": "bearer"
  }
}
