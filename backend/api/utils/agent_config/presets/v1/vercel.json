{
  "schemaVersion": 1,
  "id": "vercel",
  "name": "Vercel",
  "description": "The Vercel REST API with an access token.",
  "docsUrl": "https://vercel.com/docs/rest-api",
  "category": "cloud",
  "hostsEditable": false,
  "labels": {
    "token": "Access token"
  },
  "definition": {
    "specVersion": 1,
    "hosts": [
      {
        "match": "exact",
        "value": "api.vercel.com",
        "port": 443
      }
    ],
    "fields": [
      {
        "name": "token",
        "kind": "secret",
        "source": {
          "type": "sealed"
        },
        "env": "VERCEL_TOKEN"
      }
    ],
    "injections": [
      {
        "type": "header",
        "name": "Authorization",
        "prefix": "Bearer ",
        "field": "token",
        "whenAbsent": "attach"
      }
    ],
    "preset": "bearer"
  }
}
