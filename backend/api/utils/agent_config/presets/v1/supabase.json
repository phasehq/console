{
  "schemaVersion": 1,
  "id": "supabase",
  "name": "Supabase",
  "description": "The Supabase Management API with a personal access token. This is not a project's data API.",
  "docsUrl": "https://supabase.com/docs/reference/api/introduction",
  "category": "cloud",
  "hostsEditable": false,
  "labels": {
    "token": "Personal access token"
  },
  "definition": {
    "specVersion": 1,
    "hosts": [
      {
        "match": "exact",
        "value": "api.supabase.com",
        "port": 443,
        "path": "/v1/*"
      }
    ],
    "fields": [
      {
        "name": "token",
        "kind": "secret",
        "source": {
          "type": "sealed"
        },
        "env": "SUPABASE_ACCESS_TOKEN",
        "decoyPrefix": "sbp_"
      }
    ],
    "injections": [
      {
        "type": "header",
        "name": "Authorization",
        "prefix": "Bearer ",
        "field": "token",
        "whenAbsent": "attach"
      }
    ],
    "preset": "bearer"
  }
}
